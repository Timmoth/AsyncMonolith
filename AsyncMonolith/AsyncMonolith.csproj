<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IsAsyncMonolithPackage>true</IsAsyncMonolithPackage>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageId>AsyncMonolith</PackageId>
		<Description>Transactional outbox, background consumers and scheduled messages for .NET monoliths on EF Core.</Description>
		<Title>Async Monolith</Title>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Cronos" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="$(AssemblyName).TestHelpers" />
		<InternalsVisibleTo Include="$(AssemblyName).Tests" />
	</ItemGroup>
</Project>