<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Pomelo has no EF Core 10 release yet and declares EF Core 9; MySQL/MariaDB on EF Core 10 is untested. -->
		<NoWarn>$(NoWarn);NU1608</NoWarn>
		<!-- Prerelease until Pomelo supports EF Core 10 and these run in the integration tests. -->
		<VersionSuffix>preview.1</VersionSuffix>
		<NoWarn>NU5104</NoWarn>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>AsyncMonolith.MariaDb</PackageId>
		<Authors>Tim Jones</Authors>
		<Company>Aptacode</Company>
		<Description>MariaDb interface for AsyncMonolith</Description>
		<PackageProjectUrl>https://github.com/Timmoth/AsyncMonolith</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Timmoth/AsyncMonolith</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Monolith Messaging Scheduling Async</PackageTags>
		<Title>AsyncMonolith.MariaDb</Title>
		<PackageIcon>logo.png</PackageIcon>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\AsyncMonolith\logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AsyncMonolith\AsyncMonolith.csproj" />
		<PackageReference Include="Pomelo.EntityFrameworkCore.MySql" />
		<PackageReference Include="MySqlConnector" />
	</ItemGroup>
</Project>
